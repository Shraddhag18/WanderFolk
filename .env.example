# Copy this file to .env and paste your keys after the = sign (no quotes, no spaces).
# The app still runs with no keys at all: it uses an offline memory store and rules only.

# Mem0: app.mem0.ai -> API Keys
MEM0_API_KEY=

# Claude: console.anthropic.com -> API Keys (needs a few dollars of credit)
ANTHROPIC_API_KEY=
# Optional: change the model (default is fast and cheap)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Use OpenAI instead of Claude? Leave ANTHROPIC_API_KEY empty and fill this in:
# OPENAI_API_KEY=

# Emergency switch: venue Wi-Fi is down? Set to true to use the offline store.
FORCE_LOCAL_MEMORY=false

# Privacy: stop the mem0 library from sending anonymous usage telemetry
MEM0_TELEMETRY=False
